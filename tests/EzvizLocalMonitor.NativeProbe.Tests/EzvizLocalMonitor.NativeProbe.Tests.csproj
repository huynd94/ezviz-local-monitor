<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeCandidate)' == 'baseline'">
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" Condition="'$(EnableNativeRuntime)' == 'true' and '$(OS)' == 'Windows_NT'" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.10.0.20241108" Condition="'$(EnableNativeRuntime)' == 'true' and $([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeCandidate)' == 'headless5'">
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261003" />
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261003" Condition="'$(EnableNativeRuntime)' == 'true' and '$(OS)' == 'Windows_NT'" />
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64.headless" Version="5.0.0.20261003" Condition="'$(EnableNativeRuntime)' == 'true' and $([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
</Project>
