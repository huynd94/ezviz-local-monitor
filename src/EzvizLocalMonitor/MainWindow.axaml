<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EzvizLocalMonitor.MainWindow"
        Title="EZVIZ Local Monitor" Icon="/Assets/ezviz-local-monitor.ico" Width="1220" Height="810" MinWidth="860" MinHeight="560"
        Background="{DynamicResource AppBackgroundBrush}" Closing="Window_Closing" KeyDown="Window_KeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#093B5A" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#D8EDF8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9E1E8" />
    <SolidColorBrush x:Key="HeadingBrush" Color="#093B5A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#52606D" />
    <SolidColorBrush x:Key="InfoBrush" Color="#EAF4F9" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#B8D6E5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF8E8" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0C36D" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#805B12" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#2B1B00" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#F4F7F9" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#14202B" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#14202B" />
    <SolidColorBrush x:Key="TabForegroundBrush" Color="#17324D" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#0B4F71" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#083B55" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#126D96" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#06364D" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#14202B" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#5A6B78" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#0078B8" />
    <SolidColorBrush x:Key="InputWatermarkBrush" Color="#52606D" />
    <SolidColorBrush x:Key="CameraStatusBackgroundBrush" Color="#EAF4F9" />
    <SolidColorBrush x:Key="CameraStatusForegroundBrush" Color="#102A43" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:pressed">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:focus">
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>
  <Grid Margin="12" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="EZVIZ Local Monitor" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Nhận diện người cục bộ · C6N &amp; H8C · Telegram &amp; Zalo Bot" Foreground="{DynamicResource HeaderMutedBrush}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="GlobalStatusText" Text="Chưa khởi động giám sát" Foreground="{DynamicResource HeaderForegroundBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
          <TextBlock Text="Video và suy luận giữ trong LAN" Foreground="{DynamicResource HeaderMutedBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Tổng quan">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,5">
            <WrapPanel Orientation="Horizontal">
              <Border Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Bố cục" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,8,0" />
                  <Button x:Name="LayoutOneButton" Tag="1" Content="1 ô" Click="LayoutMode_Click" Margin="0,0,6,0" ToolTip.Tip="Hiển thị một camera chiếm toàn bộ vùng xem trước." />
                  <Button x:Name="LayoutTwoButton" Tag="2" Content="2 ô" Click="LayoutMode_Click" Margin="0,0,6,0" ToolTip.Tip="Chia vùng xem trước thành hai ô camera." />
                  <Button x:Name="LayoutFourButton" Tag="4" Content="4 ô" Click="LayoutMode_Click" Margin="0,0,6,0" ToolTip.Tip="Chia vùng xem trước thành tối đa bốn ô camera." />
                  <Button Content="Phóng to" Click="FocusSelectedCamera_Click" ToolTip.Tip="Phóng to camera đang chọn hoặc camera đầu tiên" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Hiển thị" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,8,0" />
                  <Button Content="Sáng/Tối" Click="ToggleTheme_Click" Margin="0,0,8,0" ToolTip.Tip="Chuyển nhanh sáng/tối và đưa lựa chọn về theme Dark/Light" />
                  <ComboBox x:Name="PreviewFitCombo" Width="125" SelectedIndex="0" SelectionChanged="PreviewFit_SelectionChanged" Margin="0,0,8,0" ToolTip.Tip="Chọn giữ nguyên tỷ lệ để xem đầy đủ khung hình hoặc lấp đầy khung để tận dụng tối đa diện tích preview.">
                    <ComboBoxItem Content="Giữ nguyên tỷ lệ" />
                    <ComboBoxItem Content="Lấp đầy khung" />
                  </ComboBox>
                  <TextBlock Text="Theme" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,6,0" />
                  <ComboBox x:Name="ThemeCombo" Width="120" SelectedIndex="5" SelectionChanged="Theme_SelectionChanged" Margin="0,0,8,0" ToolTip.Tip="Chọn palette màu Orchid, Ocean, Midnight, Lavender, Crimson hoặc Dark/Light. Lựa chọn được lưu vào cấu hình." >
                    <ComboBoxItem Content="Orchid" />
                    <ComboBoxItem Content="Ocean" />
                    <ComboBoxItem Content="Midnight" />
                    <ComboBoxItem Content="Lavender" />
                    <ComboBoxItem Content="Crimson" />
                    <ComboBoxItem Content="Dark/Light" />
                  </ComboBox>
                  <TextBlock Text="Chế độ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,6,0" />
                  <ComboBox x:Name="DashboardViewModeCombo" Width="105" SelectedIndex="0" SelectionChanged="DashboardViewMode_SelectionChanged" ToolTip.Tip="Giám sát ưu tiên preview lớn và trạng thái ngắn; Vận hành hiển thị thêm thông tin kỹ thuật.">
                    <ComboBoxItem Content="Giám sát" />
                    <ComboBoxItem Content="Vận hành" />
                  </ComboBox>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Hiệu năng" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,8,0" />
                  <ComboBox x:Name="PerformanceProfileCombo" Width="150" SelectedIndex="1" SelectionChanged="PerformanceProfile_Changed" ToolTip.Tip="Chọn cân bằng giữa mức dùng CPU, tốc độ nhận diện và độ trễ. Máy i7-7500U nên bắt đầu với Cân bằng." >
                    <ComboBoxItem Content="Tiết kiệm CPU" />
                    <ComboBoxItem Content="Cân bằng" />
                    <ComboBoxItem Content="Phản hồi nhanh" />
                    <ComboBoxItem Content="Ưu tiên ONVIF" />
                  </ComboBox>
                </StackPanel>
              </Border>
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="Tối đa 4 camera · Phím tắt: Ctrl+1/2/4, F11, Esc." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
          </Grid>
          <Grid x:Name="CameraGrid" Grid.Row="1" Background="#19232D" RowDefinitions="*" ColumnDefinitions="*,*">
            <Border x:Name="CameraTileOne" Background="#19232D" CornerRadius="5" Margin="2">
              <Grid RowDefinitions="*,Auto">
                <Image x:Name="PreviewOne" Stretch="Uniform" />
                <Border Background="#B0101720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4"><TextBlock x:Name="CameraOneOverlay" Text="Camera 1" Foreground="White" FontWeight="SemiBold" /></Border>
                <Button x:Name="CameraOneFocusButton" Grid.Row="0" Tag="0" Content="Phóng to" Click="FocusCameraTile_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4" ToolTip.Tip="Phóng to camera này" />
                <TextBlock x:Name="CameraOneStatus" Grid.Row="1" Text="Camera 1 chưa cấu hình" Background="{DynamicResource CameraStatusBackgroundBrush}" Foreground="{DynamicResource CameraStatusForegroundBrush}" TextWrapping="Wrap" Padding="6" />
              </Grid>
            </Border>
            <Border x:Name="CameraTileTwo" Grid.Column="1" Background="#19232D" CornerRadius="5" Margin="2">
              <Grid RowDefinitions="*,Auto">
                <Image x:Name="PreviewTwo" Stretch="Uniform" />
                <Border Background="#B0101720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4"><TextBlock x:Name="CameraTwoOverlay" Text="Camera 2" Foreground="White" FontWeight="SemiBold" /></Border>
                <Button x:Name="CameraTwoFocusButton" Grid.Row="0" Tag="1" Content="Phóng to" Click="FocusCameraTile_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4" ToolTip.Tip="Phóng to camera này" />
                <TextBlock x:Name="CameraTwoStatus" Grid.Row="1" Text="Camera 2 chưa cấu hình" Background="{DynamicResource CameraStatusBackgroundBrush}" Foreground="{DynamicResource CameraStatusForegroundBrush}" TextWrapping="Wrap" Padding="6" />
              </Grid>
            </Border>
            <Border x:Name="CameraTileThree" Background="#19232D" CornerRadius="5" Margin="2" IsVisible="False">
              <Grid RowDefinitions="*,Auto">
                <Image x:Name="PreviewThree" Stretch="Uniform" />
                <Border Background="#B0101720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4"><TextBlock x:Name="CameraThreeOverlay" Text="Camera 3" Foreground="White" FontWeight="SemiBold" /></Border>
                <Button x:Name="CameraThreeFocusButton" Grid.Row="0" Tag="2" Content="Phóng to" Click="FocusCameraTile_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4" ToolTip.Tip="Phóng to camera này" />
                <TextBlock x:Name="CameraThreeStatus" Grid.Row="1" Text="Camera 3 chưa cấu hình" Background="{DynamicResource CameraStatusBackgroundBrush}" Foreground="{DynamicResource CameraStatusForegroundBrush}" TextWrapping="Wrap" Padding="6" />
              </Grid>
            </Border>
            <Border x:Name="CameraTileFour" Grid.Column="1" Background="#19232D" CornerRadius="5" Margin="2" IsVisible="False">
              <Grid RowDefinitions="*,Auto">
                <Image x:Name="PreviewFour" Stretch="Uniform" />
                <Border Background="#B0101720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4"><TextBlock x:Name="CameraFourOverlay" Text="Camera 4" Foreground="White" FontWeight="SemiBold" /></Border>
                <Button x:Name="CameraFourFocusButton" Grid.Row="0" Tag="3" Content="Phóng to" Click="FocusCameraTile_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4" ToolTip.Tip="Phóng to camera này" />
                <TextBlock x:Name="CameraFourStatus" Grid.Row="1" Text="Camera 4 chưa cấu hình" Background="{DynamicResource CameraStatusBackgroundBrush}" Foreground="{DynamicResource CameraStatusForegroundBrush}" TextWrapping="Wrap" Padding="6" />
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,4,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
              <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Bắt đầu giám sát" Click="StartMonitoring_Click" Margin="0,0,4,4" />
                <Button Content="Dừng" Click="StopMonitoring_Click" Margin="0,0,4,4" />
                <Button x:Name="OpenEventsFolderButton" Content="Mở thư mục sự kiện" Click="OpenEventsFolder_Click" Margin="0,0,4,4" />
              </WrapPanel>
              <TextBlock x:Name="RuntimeInfoText" Grid.Column="1" FontSize="11" Text="1 lần suy luận/giây/camera" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,4" />
              <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Border Width="140" MinHeight="30" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,2,0">
                  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><TextBlock Text="CAMERA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Grid.Column="1" x:Name="SystemHealthText" Text="Đang khởi tạo…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </Border>
                <Border Width="160" MinHeight="30" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,2,0">
                  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><TextBlock Text="KẾT NỐI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Grid.Column="1" x:Name="CameraHealthText" Text="Đang khởi tạo…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </Border>
                <Border Width="155" MinHeight="30" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,2,0">
                  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><TextBlock Text="CẢNH BÁO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Grid.Column="1" x:Name="AlertHealthText" Text="Đang khởi tạo…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </Border>
                <Border Width="110" MinHeight="30" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,2,0">
                  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><TextBlock Text="AI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Grid.Column="1" x:Name="AiHealthText" Text="Đang tắt" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </Border>
                <Border Width="160" MinHeight="30" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4">
                  <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center"><TextBlock Text="SỰ KIỆN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip.Tip="Sự kiện gần nhất" /><TextBlock Grid.Column="1" x:Name="LastEventHealthText" Text="Chưa có" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                </Border>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Camera">
        <Grid Margin="12" ColumnDefinitions="300,*">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,12,0">
            <Grid RowDefinitions="*,Auto"><ListBox x:Name="CameraList" SelectionChanged="CameraList_SelectionChanged" /><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="Thêm" Click="AddCamera_Click" /><Button Content="Xóa" Click="RemoveCamera_Click" Margin="8,0,0,0" /></StackPanel></Grid>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Grid ColumnDefinitions="Auto,*"><Button Content="Tìm camera trong LAN" Click="FindCameras_Click" ToolTip.Tip="Quét camera ONVIF/RTSP trong các mạng LAN đang kết nối. Camera và máy tính phải cùng mạng; không gửi dữ liệu lên cloud." /><TextBlock x:Name="DiscoveryStatusText" Grid.Column="1" Text="Chưa quét mạng." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" ToolTip.Tip="Nếu không tìm thấy camera, kiểm tra PC và camera cùng Wi-Fi/VLAN rồi bật Local Service hoặc RTSP trong EZVIZ." /></Grid>
              <ListBox x:Name="DiscoveryList" Grid.Row="1" Height="120" Margin="0,10,0,0" />
              <Grid Grid.Row="2" Margin="0,10,0,12" ColumnDefinitions="220,*,Auto"><TextBlock Text="Mã xác thực thiết bị" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Nhập đúng 6 ký tự in hoa trên nhãn của camera EZVIZ đang chọn. Không nhập mật khẩu Wi-Fi." /><TextBox x:Name="VerificationCodeText" Grid.Column="1" PasswordChar="●" Watermark="6 ký tự trên nhãn camera" ToolTip.Tip="Mã xác thực thiết bị thường gồm 6 chữ cái in hoa, dùng để tạo RTSP/ONVIF cục bộ." /><Button Grid.Column="2" Content="Thêm camera đã chọn" Click="AddSelectedDiscovery_Click" Margin="10,0,0,0" ToolTip.Tip="Thêm camera đang chọn sau khi kiểm tra mã xác thực và đọc thử một frame RTSP." /></Grid>
              <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="220,*">

                <TextBlock Text="Tên hiển thị" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Tên dễ nhận biết để hiển thị trong Tổng quan, trạng thái camera và nhật ký sự kiện." /><TextBox x:Name="CameraNameText" Grid.Column="1" ToolTip.Tip="Đặt tên ngắn, ví dụ: Cửa trước hoặc Phòng khách. Tên này không thay đổi tên camera trong EZVIZ." />
                <TextBlock Grid.Row="1" Text="RTSP URL" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Địa chỉ luồng video cục bộ. Ứng dụng ưu tiên tự tạo sau khi chọn camera; chỉ nhập thủ công nếu bạn đã có URL RTSP hợp lệ." /><TextBox x:Name="CameraRtspText" Grid.Row="1" Grid.Column="1" Watermark="Tự tạo sau khi chọn camera, hoặc nhập thủ công" ToolTip.Tip="Ví dụ dạng: rtsp://admin:&lt;mã xác thực&gt;@&lt;IP camera&gt;:554/ch1/main. Không gửi URL này qua chat vì có thể chứa thông tin truy cập." />
                <TextBlock Grid.Row="2" Text="Ngưỡng nhận diện" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Độ tin cậy tối thiểu của YOLO để coi vùng phát hiện là người. Tăng giá trị giúp giảm cảnh báo giả nhưng có thể bỏ sót người ở xa." /><Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto"><Slider x:Name="ConfidenceSlider" Minimum="0.30" Maximum="0.90" Value="0.55" TickFrequency="0.05" IsSnapToTickEnabled="True" ToolTip.Tip="Kéo sang phải để yêu cầu độ tin cậy cao hơn; bắt đầu khoảng 0.50–0.60 rồi điều chỉnh theo ánh sáng thực tế." /><TextBlock x:Name="ConfidenceText" Grid.Column="1" Width="72" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid>
                <TextBlock Grid.Row="3" Text="Khoảng im lặng (giây)" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Thời gian tối thiểu giữa hai cảnh báo của cùng camera. Dùng để tránh gửi lặp khi một người đứng lâu trong khung hình." /><TextBox x:Name="CooldownText" Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" ToolTip.Tip="Nhập số giây, ví dụ 30. Giá trị càng lớn thì cảnh báo lặp càng thưa; hệ thống luôn giữ tối thiểu 1 giây." />
                <TextBlock Grid.Row="4" Text="Người xuất hiện tối thiểu (giây)" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip.Tip="Số giây người phải xuất hiện liên tục trước khi tạo cảnh báo, giúp giảm nhiễu do phát hiện chớp nhoáng." /><TextBox x:Name="MinPresenceText" Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" ToolTip.Tip="Nhập số thực từ 0 đến 30, ví dụ 1.0. Giá trị 1.0 yêu cầu người xuất hiện liên tục khoảng một giây." />
                <TextBlock Grid.Row="5" Text="Bật giám sát" VerticalAlignment="Center" ToolTip.Tip="Chỉ camera được bật và có RTSP URL hợp lệ mới được đưa vào pipeline giám sát." /><CheckBox x:Name="CameraEnabledCheck" Grid.Row="5" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Content="Camera này được phép giám sát" ToolTip.Tip="Bỏ chọn nếu muốn lưu camera nhưng tạm thời không đọc luồng hoặc phát hiện người." />
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8"><Button Content="Lưu camera" Click="SaveCamera_Click" ToolTip.Tip="Lưu các trường của camera đang chọn. Cấu hình được mã hóa trong tài khoản Windows." /><Button Content="Kiểm tra RTSP" Click="TestRtsp_Click" ToolTip.Tip="Mở thử luồng RTSP và đọc frame để xác nhận URL, mã xác thực và kết nối LAN trước khi giám sát." /></StackPanel>
              </Grid></Border>
            </Grid>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Lịch giám sát">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto">
          <Border Background="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
            <TextBlock Text="Khi có ít nhất một lịch đang bật, ứng dụng chỉ giám sát trong các khoảng thời gian phù hợp. Ngày dùng Mon, Tue, Wed, Thu, Fri, Sat, Sun hoặc Weekday/Weekend; khoảng giờ qua nửa đêm được hỗ trợ." TextWrapping="Wrap" Foreground="{DynamicResource HeadingBrush}" />
          </Border>
          <DataGrid x:Name="ScheduleGrid" Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="False" CanUserResizeColumns="True" Margin="0,12,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="2*" />
              <DataGridCheckBoxColumn Header="Bật" Binding="{Binding IsEnabled}" Width="80" />
              <DataGridTextColumn Header="Ngày" Binding="{Binding Days}" Width="2*" />
              <DataGridTextColumn Header="Từ" Binding="{Binding StartTime}" Width="110" />
              <DataGridTextColumn Header="Đến" Binding="{Binding EndTime}" Width="110" />
              <DataGridTextColumn Header="Hồ sơ (0-3)" Binding="{Binding PerformanceProfile}" Width="130" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Thêm lịch" Click="AddSchedule_Click" Margin="0,0,8,8" ToolTip.Tip="Thêm một dòng lịch mẫu để chỉnh sửa trực tiếp trong bảng." /><Button Content="Xóa lịch chọn" Click="RemoveSchedule_Click" Margin="0,0,8,8" ToolTip.Tip="Xóa dòng lịch đang chọn khỏi danh sách hiện tại." /><Button Content="Lưu lịch" Click="SaveSchedules_Click" Margin="0,0,0,8" ToolTip.Tip="Lưu các dòng lịch vào cấu hình mã hóa. Lịch có hiệu lực khi có ít nhất một dòng được bật." /></WrapPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Cảnh báo">
        <ScrollViewer><StackPanel Margin="16" Spacing="12">
          <TextBlock Text="Tab này chỉ quản lý kênh thông báo và phân tích AI. Khởi động Windows, watchdog, log, backup và chẩn đoán nằm trong tab Cài đặt hệ thống." Foreground="{DynamicResource HeadingBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Background="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Kiểm tra cấu hình" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><TextBlock Text="Kiểm tra trường bắt buộc và trạng thái kênh; không tự gửi tin nhắn." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Kiểm tra toàn bộ cấu hình" Click="ValidateAlerts_Click" ToolTip.Tip="Kiểm tra token, Chat ID, endpoint và các trường bắt buộc. Nút này không gửi tin nhắn thật." /><TextBlock x:Name="ConfigurationCheckText" Grid.Row="1" Grid.ColumnSpan="2" Text="Chưa kiểm tra cấu hình." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /></Grid></Border>
          <TextBlock Text="Kênh thông báo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,4,0,0" />
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="220,*,Auto"><CheckBox x:Name="TelegramEnabledCheck" Content="Bật Telegram" ToolTip.Tip="Bật để gửi văn bản và ảnh sự kiện qua Telegram Bot." /><TextBlock Grid.Row="1" Text="Bot Token" VerticalAlignment="Center" ToolTip.Tip="Token do BotFather cấp, thường có dạng số:chuỗi. Dữ liệu được lưu mã hóa và không ghi vào log." /><TextBox x:Name="TelegramTokenText" Grid.Row="1" Grid.Column="1" PasswordChar="●" ToolTip.Tip="Dán Bot Token Telegram tại đây. Không gửi token qua chat hoặc đưa vào ảnh chụp màn hình." /><TextBlock Grid.Row="2" Text="Chat ID" VerticalAlignment="Center" ToolTip.Tip="ID cuộc trò chuyện, nhóm hoặc kênh Telegram nhận cảnh báo." /><TextBox x:Name="TelegramChatText" Grid.Row="2" Grid.Column="1" ToolTip.Tip="Nhập đúng Chat ID của nơi nhận thông báo. Có thể là số âm nếu dùng nhóm." /><Button Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Content="Gửi thử" Click="TestTelegram_Click" Margin="10,0,0,0" ToolTip.Tip="Gửi một tin nhắn kiểm thử đến Telegram để xác nhận token và Chat ID." /></Grid></Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="220,*,Auto"><CheckBox x:Name="ZaloEnabledCheck" Content="Bật Zalo Bot" ToolTip.Tip="Bật để gửi văn bản cảnh báo qua Zalo Bot ZApps. Ảnh chỉ gửi được khi có URL HTTPS công khai." /><TextBlock Grid.Row="1" Text="Bot Token" VerticalAlignment="Center" ToolTip.Tip="Token do Zalo Bot ZApps cấp. Dữ liệu được lưu mã hóa và không ghi đầy đủ vào log." /><TextBox x:Name="ZaloTokenText" Grid.Row="1" Grid.Column="1" PasswordChar="●" ToolTip.Tip="Dán Bot Token Zalo Bot ZApps tại đây; không sử dụng token Official Account nếu API yêu cầu Bot Token." /><TextBlock Grid.Row="2" Text="Chat ID" VerticalAlignment="Center" ToolTip.Tip="ID cuộc trò chuyện Zalo nhận cảnh báo." /><TextBox x:Name="ZaloChatText" Grid.Row="2" Grid.Column="1" ToolTip.Tip="Nhập Chat ID lấy từ Zalo Bot ZApps. Có thể bấm Gửi thử để kiểm tra." /><Button Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Content="Gửi thử" Click="TestZalo_Click" Margin="10,0,0,0" ToolTip.Tip="Gửi tin nhắn văn bản kiểm thử đến Zalo; không gửi ảnh local trong bước này." /><CheckBox x:Name="ZaloImageRelayEnabledCheck" Grid.Row="3" Grid.ColumnSpan="2" Content="Bật relay ảnh qua HTTPS tùy chỉnh" Margin="0,8,0,0" ToolTip.Tip="Cho phép upload ảnh sự kiện lên endpoint HTTPS tùy chỉnh trước khi gửi URL ảnh cho Zalo." /><TextBlock Grid.Row="4" Text="Relay URL" VerticalAlignment="Center" ToolTip.Tip="Endpoint HTTPS nhận multipart ảnh và trả về URL HTTPS công khai." /><TextBox x:Name="ZaloImageRelayUrlText" Grid.Row="4" Grid.Column="1" Watermark="https://example.com/upload" ToolTip.Tip="Nhập URL bắt đầu bằng https://. Endpoint cần nhận trường file và trả về url, photo_url hoặc image_url." /><TextBlock Grid.Row="5" Text="Relay API key" VerticalAlignment="Center" ToolTip.Tip="API key tùy chọn của endpoint relay; để trống nếu endpoint không yêu cầu." /><TextBox x:Name="ZaloImageRelayApiKeyText" Grid.Row="5" Grid.Column="1" PasswordChar="●" ToolTip.Tip="API key được gửi dưới dạng Bearer header và lưu mã hóa; không đưa key vào URL." /><CheckBox x:Name="ZaloAllowImageRelayCheck" Grid.Row="3" Grid.Column="2" Content="Tôi đồng ý ảnh rời LAN" Margin="10,8,0,0" ToolTip.Tip="Phải đánh dấu rõ ràng nếu đồng ý upload ảnh sự kiện ra ngoài mạng LAN. Bỏ chọn để giữ ảnh hoàn toàn local." /></Grid></Border>
          <TextBlock Text="Phân tích AI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Margin="0,4,0,0" />
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="220,*"><CheckBox x:Name="AiEnabledCheck" Foreground="{DynamicResource ControlForegroundBrush}" Content="Bật phân tích AI cho sự kiện" ToolTip.Tip="Bật để gửi tối đa hai ảnh JPEG sự kiện tới endpoint OpenAI-compatible đã cấu hình. Video RTSP không được gửi." /><TextBlock Grid.Row="1" Text="Base URL" Foreground="{DynamicResource ControlForegroundBrush}" VerticalAlignment="Center" ToolTip.Tip="Địa chỉ gốc của API OpenAI-compatible, không phải URL đầy đủ của chat completions." /><TextBox x:Name="AiBaseUrlText" Grid.Row="1" Grid.Column="1" Watermark="https://api.openai.com/v1" ToolTip.Tip="Ví dụ https://api.openai.com/v1 hoặc endpoint nội bộ. Chỉ dùng HTTPS khi endpoint ở ngoài LAN." /><TextBlock Grid.Row="2" Text="Model" Foreground="{DynamicResource ControlForegroundBrush}" VerticalAlignment="Center" ToolTip.Tip="Tên model có khả năng nhận ảnh theo API endpoint, ví dụ model vision tương thích." /><TextBox x:Name="AiModelText" Grid.Row="2" Grid.Column="1" Watermark="Vision-capable model" ToolTip.Tip="Nhập chính xác tên model mà endpoint hỗ trợ; model không có vision sẽ không phân tích được ảnh." /><TextBlock Grid.Row="3" Text="API key" Foreground="{DynamicResource ControlForegroundBrush}" VerticalAlignment="Center" ToolTip.Tip="API key của endpoint AI. Key được lưu mã hóa và không đưa vào log." /><TextBox x:Name="AiApiKeyText" Grid.Row="3" Grid.Column="1" PasswordChar="●" ToolTip.Tip="Dán API key tại đây; không gửi key qua chat hoặc đưa vào ảnh chụp màn hình." /><Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="220,120,*"><TextBlock Text="Timeout (giây)" Foreground="{DynamicResource ControlForegroundBrush}" VerticalAlignment="Center" ToolTip.Tip="Thời gian tối đa chờ endpoint AI phản hồi cho một sự kiện." /><TextBox x:Name="AiTimeoutText" Grid.Column="1" ToolTip.Tip="Nhập số giây, thường 15–30. Timeout ngắn giúp cảnh báo không bị chậm quá lâu." /><CheckBox x:Name="AiRequireConfirmationCheck" Grid.Column="2" Foreground="{DynamicResource ControlForegroundBrush}" Content="Chỉ gửi cảnh báo khi AI xác nhận chuyển động/người" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Nếu bật, cảnh báo chỉ gửi sau khi AI xác nhận. Nếu ưu tiên độ trễ thấp, nên tắt tùy chọn này." /></Grid></Grid></Border>
          <TextBlock Text="Khi AI bật, tối đa hai ảnh JPEG của sự kiện (trước/sau) được gửi tới endpoint đã cấu hình; video RTSP không được gửi." TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Xuất chẩn đoán cấu hình" Click="ExportDiagnostics_Click" Margin="0,0,8,8" ToolTip.Tip="Tạo ZIP chẩn đoán đã che token, API key, Chat ID, IP LAN và mã xác thực. Hãy kiểm tra nội dung trước khi chia sẻ." /><Button Content="Lưu cấu hình cảnh báo và AI" Click="SaveAlerts_Click" Margin="0,0,0,8" ToolTip.Tip="Lưu token, endpoint và tùy chọn AI vào cấu hình mã hóa." /></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Cài đặt hệ thống">
        <ScrollViewer><StackPanel Margin="16" Spacing="12">
          <Border Background="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Cài đặt toàn ứng dụng" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><TextBlock Text="Các tùy chọn bên dưới áp dụng cho vòng đời ứng dụng, log chẩn đoán, Auto-Update và dữ liệu cục bộ. Thay đổi chỉ có hiệu lực sau khi bấm Lưu cài đặt hệ thống." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel></Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><StackPanel Spacing="8"><TextBlock Text="Khởi động và cập nhật" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><CheckBox x:Name="StartWithWindowsCheck" Content="Khởi động cùng Windows ở chế độ nền (khay thông báo)" ToolTip.Tip="Tạo Task Scheduler chạy ứng dụng sau khi đăng nhập Windows với --background." /><CheckBox x:Name="WatchdogEnabledCheck" Content="Bật watchdog tự khởi động lại sau khi tiến trình thoát bất thường" ToolTip.Tip="Tiến trình phụ theo dõi ứng dụng và khởi động lại sau crash; không khởi động lại khi chọn Thoát hoàn toàn." /><CheckBox x:Name="AutoUpdateEnabledCheck" Content="Tự động kiểm tra bản cập nhật khi mở giao diện" ToolTip.Tip="Kiểm tra GitHub public release khi mở giao diện chính. Khi ứng dụng chỉ chạy nền trong tray, không mở hộp thoại cập nhật." /><TextBlock Text="Task startup và watchdog không làm ứng dụng tự khởi động lại sau khi bạn chọn Thoát hoàn toàn." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" /><Button Content="Lưu cài đặt hệ thống" Click="SaveSystemSettings_Click" HorizontalAlignment="Right" ToolTip.Tip="Lưu startup, watchdog, Auto-Update và công tắc log." /></StackPanel></Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><StackPanel Spacing="8"><TextBlock Text="Nhật ký vận hành" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><CheckBox x:Name="LoggingEnabledCheck" Content="Bật log vận hành hệ thống" ToolTip.Tip="Ghi app.log, camera.log và ai.log. Tắt để giảm ghi đĩa; cảnh báo lỗi vẫn hiển thị trên giao diện." /><CheckBox x:Name="AlertLoggingEnabledCheck" Content="Bật log cảnh báo Telegram/Zalo" ToolTip.Tip="Ghi alerts.log và zalo-send.log. Tắt nếu không muốn lưu chi tiết gửi cảnh báo." /><WrapPanel Orientation="Horizontal"><Button Tag="app" Content="Mở log hệ thống" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Tag="camera" Content="Mở log camera" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Tag="alerts" Content="Mở log Telegram/Zalo" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Tag="ai" Content="Mở log AI" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Tag="zalo" Content="Mở log Zalo riêng" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Tag="startup" Content="Mở log khởi động" Click="OpenSystemLog_Click" Margin="0,0,6,6" /><Button Content="Xóa toàn bộ log vận hành" Click="ClearSystemLogs_Click" Margin="0,0,0,6" ToolTip.Tip="Xóa app.log, camera.log, alerts.log, ai.log, zalo-send.log và startup-crash.log cùng file xoay .1. Luôn hỏi xác nhận." /></WrapPanel></StackPanel></Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><StackPanel Spacing="8"><TextBlock Text="Backup, khôi phục và chẩn đoán" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><TextBlock Text="Backup cấu hình dùng Windows DPAPI và chỉ khôi phục được bằng đúng tài khoản Windows đã tạo file. Gói chẩn đoán đã che thông tin nhạy cảm nhưng nên kiểm tra trước khi chia sẻ." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /><WrapPanel Orientation="Horizontal"><Button Content="Sao lưu cấu hình" Click="BackupSettings_Click" Margin="0,0,8,6" /><Button Content="Khôi phục cấu hình" Click="RestoreSettings_Click" Margin="0,0,8,6" /><Button Content="Xuất gói chẩn đoán" Click="ExportDiagnostics_Click" Margin="0,0,8,6" /><Button Content="Mở thư mục dữ liệu" Click="OpenDataFolder_Click" Margin="0,0,0,6" /></WrapPanel></StackPanel></Border>
          <Border Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><StackPanel Spacing="4"><TextBlock Text="Các cấu hình hệ thống khác" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" /><TextBlock Text="Theme, bố cục camera, chế độ Giám sát/Vận hành và hồ sơ hiệu năng nằm ở Tổng quan để điều chỉnh nhanh. Lọc thời gian và dọn sự kiện/ảnh nằm ở Nhật ký sự kiện vì gắn trực tiếp với lịch sử camera. Mã hóa DPAPI và chính sách giữ log là mặc định an toàn, không nên tắt tùy tiện." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Hướng dẫn &amp; Tác giả">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="12">
            <Border Background="{DynamicResource InfoBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Text="Hướng dẫn sử dụng EZVIZ Local Monitor" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="Ứng dụng giám sát cục bộ camera EZVIZ C6N/H8C trong mạng LAN. Video, nhận diện YOLO và dữ liệu sự kiện được xử lý tại máy Windows; ảnh chỉ rời LAN khi bạn bật kênh hoặc relay tương ứng." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Bắt đầu nhanh" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="1. Đặt máy tính và camera trong cùng Wi-Fi hoặc VLAN. Bật Local Service/RTSP trên camera nếu firmware yêu cầu." TextWrapping="Wrap" />
                <TextBlock Text="2. Mở tab Camera, bấm Tìm camera trong LAN, chọn camera và nhập mã xác thực 6 ký tự trên nhãn thiết bị." TextWrapping="Wrap" />
                <TextBlock Text="3. Bấm Thêm camera đã chọn, kiểm tra RTSP, đặt tên hiển thị rồi bấm Lưu camera. Chỉ camera được bật mới được giám sát." TextWrapping="Wrap" />
                <TextBlock Text="4. Chọn hồ sơ hiệu năng phù hợp trong Tổng quan. Với máy i7-7500U, nên bắt đầu bằng Cân bằng và một đến hai camera." TextWrapping="Wrap" />
                <TextBlock Text="5. Ứng dụng tự bắt đầu giám sát sau khi cấu hình hợp lệ. Dùng Dừng hoặc Bắt đầu giám sát để điều khiển thủ công." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Giảm cảnh báo giả" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="Ngưỡng nhận diện quyết định độ tin cậy tối thiểu của YOLO. Khoảng im lặng giới hạn tần suất cảnh báo lặp của cùng camera. Người xuất hiện tối thiểu yêu cầu người phải hiện diện liên tục đủ số giây trước khi tạo cảnh báo." TextWrapping="Wrap" />
                <TextBlock Text="Nếu có cảnh báo giả, hãy tăng Ngưỡng nhận diện hoặc Người xuất hiện tối thiểu. Nếu cảnh báo chậm hoặc bỏ sót người, giảm các giá trị này và chọn hồ sơ hiệu năng phù hợp." TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Cấu hình cảnh báo và AI" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="Trong tab Cảnh báo, bật Telegram hoặc Zalo rồi nhập Bot Token và Chat ID tương ứng. Bấm Gửi thử để kiểm tra văn bản; token được lưu mã hóa theo tài khoản Windows và không nên đưa vào ảnh chụp màn hình." TextWrapping="Wrap" />
                <TextBlock Text="Relay ảnh Zalo chỉ cần khi bạn muốn ảnh local được upload tới endpoint HTTPS tùy chỉnh. Phải bật relay và đánh dấu Tôi đồng ý ảnh rời LAN; nếu không, ứng dụng vẫn gửi văn bản nhưng giữ ảnh trong LAN." TextWrapping="Wrap" />
                <TextBlock Text="AI endpoint là tùy chọn. Nhập Base URL, model vision và API key của endpoint OpenAI-compatible. Bật Chỉ gửi cảnh báo khi AI xác nhận nếu chấp nhận thêm độ trễ để lọc cảnh báo." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Lịch, backup và chẩn đoán" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="Tab Lịch giám sát cho phép bật các khoảng thời gian theo ngày trong tuần và hồ sơ hiệu năng. Khoảng giờ qua nửa đêm được hỗ trợ; khi có lịch bật, ứng dụng chỉ giám sát trong thời gian phù hợp." TextWrapping="Wrap" />
                <TextBlock Text="Dùng Sao lưu cấu hình để tạo file backup DPAPI. File chỉ khôi phục được trên tài khoản Windows đã tạo backup và không xuất token dạng plaintext." TextWrapping="Wrap" />
                <TextBlock Text="Khi cần hỗ trợ, dùng Mở log Zalo hoặc Xuất gói chẩn đoán. Gói chẩn đoán đã che token, Chat ID, IP LAN và mã xác thực; vẫn nên kiểm tra nội dung trước khi chia sẻ." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Text="Xử lý sự cố nhanh" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                <TextBlock Text="Không tìm thấy camera: kiểm tra cùng mạng, bật Local Service/RTSP và thử lại. RTSP không mở: kiểm tra mã xác thực, URL, firewall và firmware camera. Không nhận cảnh báo: kiểm tra camera đang bật, trạng thái Tổng quan, cooldown và thời gian xuất hiện tối thiểu." TextWrapping="Wrap" />
                <TextBlock Text="Telegram/Zalo lỗi: bấm Gửi thử, mở log, kiểm tra token/Chat ID và không gửi thông tin bí mật qua chat. Ứng dụng tự cô lập lỗi mạng và hàng đợi cảnh báo sẽ retry trong nền." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="Thông tin tác giả" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" Grid.ColumnSpan="2" />
                <TextBlock Text="Author" Grid.Row="1" FontWeight="SemiBold" />
                <TextBlock Text="Nguyen Duc Huy" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" />
                <TextBlock Text="Website" Grid.Row="2" FontWeight="SemiBold" />
                <Button Content="https://huynd.io.vn" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Click="OpenAuthorWebsite_Click" ToolTip.Tip="Mở website của tác giả trong trình duyệt mặc định." />
                <TextBlock Text="Email" Grid.Row="3" FontWeight="SemiBold" />
                <Button Content="huynd130994@gmail.com" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Click="SendAuthorEmail_Click" ToolTip.Tip="Mở ứng dụng email mặc định để gửi thư cho tác giả." />
                <TextBlock Text="Phiên bản" Grid.Row="4" FontWeight="SemiBold" />
                <TextBlock x:Name="AuthorVersionText" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Nhật ký sự kiện">
        <Grid Margin="12" RowDefinitions="Auto,*" ColumnDefinitions="*,340">
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="3" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
              <Button Content="Làm mới" Click="RefreshEvents_Click" Margin="0,0,4,4" />
              <TextBox x:Name="EventSearchText" Width="280" Watermark="Tìm camera, nguồn, trạng thái…" TextChanged="EventSearch_Changed" Margin="0,0,8,4" ToolTip.Tip="Lọc nhật ký theo tên camera, nguồn phát hiện hoặc trạng thái gửi cảnh báo." />
              <ComboBox x:Name="EventCameraFilter" Width="220" PlaceholderText="Tất cả camera" SelectionChanged="EventCameraFilter_Changed" Margin="0,0,8,4" ToolTip.Tip="Chỉ hiển thị sự kiện của một camera hoặc chọn tất cả camera." />
              <TextBlock Text="Thời gian" VerticalAlignment="Center" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,6,4" />
              <ComboBox x:Name="EventTimeFilterCombo" Width="155" SelectedIndex="0" SelectionChanged="EventTimeFilter_Changed" Margin="0,0,6,4" ToolTip.Tip="Lọc tất cả, 1 ngày, 2 ngày, 7 ngày gần nhất hoặc ngày chỉ định.">
                <ComboBoxItem Content="Tất cả thời gian" />
                <ComboBoxItem Content="1 ngày gần nhất" />
                <ComboBoxItem Content="2 ngày gần nhất" />
                <ComboBoxItem Content="7 ngày gần nhất" />
                <ComboBoxItem Content="Ngày chỉ định" />
              </ComboBox>
              <TextBox x:Name="EventSpecificDateText" Width="112" Watermark="yyyy-MM-dd" Margin="0,0,6,4" ToolTip.Tip="Nhập ngày theo dạng yyyy-MM-dd, ví dụ 2026-08-15, rồi bấm Áp dụng ngày." />
              <Button Content="Áp dụng ngày" Click="ApplyEventDate_Click" Margin="0,0,8,4" ToolTip.Tip="Áp dụng ngày chỉ định đang nhập." />
              <TextBlock x:Name="EventLogSummaryText" Text="Chưa tải nhật ký" Width="250" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Dọn dữ liệu" VerticalAlignment="Center" Foreground="{DynamicResource HeadingBrush}" Margin="0,0,6,4" />
              <ComboBox x:Name="CleanupRetentionCombo" Width="150" SelectedIndex="0" Margin="0,0,6,4" ToolTip.Tip="Chọn dữ liệu cần giữ lại. Thao tác sẽ xóa sự kiện, ảnh và phần log cũ hơn mốc đã chọn.">
                <ComboBoxItem Content="Giữ lại 1 ngày" />
                <ComboBoxItem Content="Giữ lại 2 ngày" />
                <ComboBoxItem Content="Giữ lại 1 tuần" />
                <ComboBoxItem Content="Giữ lại 1 tháng" />
                <ComboBoxItem Content="Xóa tất cả" />
              </ComboBox>
              <Button Content="Dọn log/sự kiện" Click="CleanupEventData_Click" Margin="0,0,8,4" ToolTip.Tip="Xóa sự kiện, ảnh và log theo chính sách giữ lại. Luôn hỏi xác nhận trước khi thực hiện." />
              <TextBlock x:Name="CleanupSummaryText" Text="Chưa dọn dữ liệu" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="EventsGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All" SelectionChanged="EventsGrid_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Thời gian" Binding="{Binding DetectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="190" />
              <DataGridTextColumn Header="Camera" Binding="{Binding CameraName}" Width="130" />
              <DataGridTextColumn Header="Phát hiện" Binding="{Binding IsHumanDetection}" Width="95" />
              <DataGridTextColumn Header="Tin cậy" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="85" />
              <DataGridTextColumn Header="Nguồn" Binding="{Binding DetectionSource}" Width="150" />
              <DataGridTextColumn Header="AI" Binding="{Binding AiStatus}" Width="150" />
              <DataGridTextColumn Header="Gửi cảnh báo" Binding="{Binding DeliveryStatus}" Width="260" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer><StackPanel Spacing="8">
              <TextBlock Text="Chi tiết sự kiện" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
              <TextBlock x:Name="EventDetailText" Text="Chọn một dòng để xem chi tiết." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
              <Border Background="#19232D" MinHeight="170"><Image x:Name="EventDetailImage" Stretch="Uniform" /></Border>
              <Button Content="Mở ảnh sự kiện" Click="OpenSelectedEventImage_Click" HorizontalAlignment="Left" />
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="0,0,0,0" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="VersionText" Text="Đang đọc phiên bản…" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
      <TextBlock x:Name="SystemMetricsText" Grid.Column="1" Text="CPU — · RAM —" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>
