<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EzvizLocalMonitor.MainWindow"
        Title="EZVIZ Local Monitor" Icon="/Assets/ezviz-local-monitor.ico" Width="1220" Height="810" MinWidth="980" MinHeight="650"
        Background="#F5F7FA" Closing="Window_Closing" KeyDown="Window_KeyDown">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#093B5A" CornerRadius="8" Padding="18" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="EZVIZ Local Monitor" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Nhận diện người cục bộ · C6N &amp; H8C · Telegram &amp; Zalo Bot" Foreground="#D8EDF8" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="GlobalStatusText" Text="Chưa khởi động giám sát" Foreground="White" HorizontalAlignment="Right" FontWeight="SemiBold" />
          <TextBlock Text="Video và suy luận giữ trong LAN" Foreground="#D8EDF8" Margin="0,5,0,0" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Tổng quan">
        <Grid Margin="12" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Bố cục giám sát:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#093B5A" />
            <Button x:Name="LayoutOneButton" Tag="1" Content="1 màn hình" Click="LayoutMode_Click" />
            <Button x:Name="LayoutTwoButton" Tag="2" Content="2 màn hình" Click="LayoutMode_Click" />
            <Button x:Name="LayoutFourButton" Tag="4" Content="4 màn hình" Click="LayoutMode_Click" />
            <Button Content="Phóng to camera" Click="FocusSelectedCamera_Click" ToolTip.Tip="Phóng to camera đang chọn hoặc camera đầu tiên" />
            <Button Content="Sáng/Tối" Click="ToggleTheme_Click" ToolTip.Tip="Chuyển giao diện sáng và tối" />
            <TextBlock Text="Hiệu năng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#093B5A" Margin="10,0,0,0" />
            <ComboBox x:Name="PerformanceProfileCombo" Width="170" SelectedIndex="1" SelectionChanged="PerformanceProfile_Changed">
              <ComboBoxItem Content="Tiết kiệm CPU" />
              <ComboBoxItem Content="Cân bằng" />
              <ComboBoxItem Content="Phản hồi nhanh" />
              <ComboBoxItem Content="Ưu tiên ONVIF" />
            </ComboBox>
            <TextBlock Text="Tối đa 4 camera; ô chưa cấu hình hiển thị trạng thái chờ. Phím tắt: Ctrl+1/2/4, F11, Esc." VerticalAlignment="Center" Foreground="#52606D" Margin="8,0,0,0" />
          </StackPanel>
          <Grid x:Name="CameraGrid" Grid.Row="1" Background="#19232D" RowDefinitions="*" ColumnDefinitions="*,*">
            <Border x:Name="CameraTileOne" Background="#19232D" CornerRadius="5" Margin="4">
              <Grid RowDefinitions="*,Auto"><Image x:Name="PreviewOne" Stretch="Uniform" /><TextBlock x:Name="CameraOneStatus" Grid.Row="1" Text="Camera 1 chưa cấu hình" Background="#EAF1F5" Padding="8" /></Grid>
            </Border>
            <Border x:Name="CameraTileTwo" Grid.Column="1" Background="#19232D" CornerRadius="5" Margin="4">
              <Grid RowDefinitions="*,Auto"><Image x:Name="PreviewTwo" Stretch="Uniform" /><TextBlock x:Name="CameraTwoStatus" Grid.Row="1" Text="Camera 2 chưa cấu hình" Background="#EAF1F5" Padding="8" /></Grid>
            </Border>
            <Border x:Name="CameraTileThree" Background="#19232D" CornerRadius="5" Margin="4" IsVisible="False">
              <Grid RowDefinitions="*,Auto"><Image x:Name="PreviewThree" Stretch="Uniform" /><TextBlock x:Name="CameraThreeStatus" Grid.Row="1" Text="Camera 3 chưa cấu hình" Background="#EAF1F5" Padding="8" /></Grid>
            </Border>
            <Border x:Name="CameraTileFour" Grid.Column="1" Background="#19232D" CornerRadius="5" Margin="4" IsVisible="False">
              <Grid RowDefinitions="*,Auto"><Image x:Name="PreviewFour" Stretch="Uniform" /><TextBlock x:Name="CameraFourStatus" Grid.Row="1" Text="Camera 4 chưa cấu hình" Background="#EAF1F5" Padding="8" /></Grid>
            </Border>
          </Grid>
          <Border Grid.Row="2" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,14,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*">
              <Button Content="Bắt đầu giám sát" Click="StartMonitoring_Click" />
              <Button Grid.Column="1" Content="Dừng" Click="StopMonitoring_Click" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="Mở thư mục sự kiện" Click="OpenEventsFolder_Click" Margin="8,0,0,0" />
              <TextBlock x:Name="RuntimeInfoText" Grid.Column="3" Text="1 lần suy luận/giây/camera" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#52606D" />
              <TextBlock x:Name="SystemHealthText" Grid.Row="1" Grid.ColumnSpan="4" Text="Hệ thống: đang khởi tạo…" Margin="0,10,0,0" Foreground="#52606D" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Camera">
        <Grid Margin="12" ColumnDefinitions="300,*">
          <Border Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,12,0">
            <Grid RowDefinitions="*,Auto"><ListBox x:Name="CameraList" SelectionChanged="CameraList_SelectionChanged" /><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="Thêm" Click="AddCamera_Click" /><Button Content="Xóa" Click="RemoveCamera_Click" Margin="8,0,0,0" /></StackPanel></Grid>
          </Border>
          <Border Grid.Column="1" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Grid ColumnDefinitions="Auto,*"><Button Content="Tìm camera trong LAN" Click="FindCameras_Click" /><TextBlock x:Name="DiscoveryStatusText" Grid.Column="1" Text="Chưa quét mạng." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#52606D" /></Grid>
              <ListBox x:Name="DiscoveryList" Grid.Row="1" Height="120" Margin="0,10,0,0" />
              <Grid Grid.Row="2" Margin="0,10,0,12" ColumnDefinitions="170,*,Auto"><TextBlock Text="Mã xác thực thiết bị" VerticalAlignment="Center" /><TextBox x:Name="VerificationCodeText" Grid.Column="1" PasswordChar="●" Watermark="6 ký tự trên nhãn camera" /><Button Grid.Column="2" Content="Thêm camera đã chọn" Click="AddSelectedDiscovery_Click" Margin="8,0,0,0" /></Grid>
              <Border Grid.Row="3" BorderBrush="#D9E1E8" BorderThickness="0,1,0,0" Padding="0,14,0,0"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="170,*">
                <TextBlock Text="Tên hiển thị" VerticalAlignment="Center" /><TextBox x:Name="CameraNameText" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="RTSP URL" VerticalAlignment="Center" /><TextBox x:Name="CameraRtspText" Grid.Row="1" Grid.Column="1" Watermark="Tự tạo sau khi chọn camera, hoặc nhập thủ công" />
                <TextBlock Grid.Row="2" Text="Ngưỡng nhận diện" VerticalAlignment="Center" /><Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto"><Slider x:Name="ConfidenceSlider" Minimum="0.30" Maximum="0.90" Value="0.55" TickFrequency="0.05" IsSnapToTickEnabled="True" /><TextBlock x:Name="ConfidenceText" Grid.Column="1" Width="60" VerticalAlignment="Center" /></Grid>
                <TextBlock Grid.Row="3" Text="Khoảng im lặng (giây)" VerticalAlignment="Center" /><TextBox x:Name="CooldownText" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="4" Text="Bật giám sát" VerticalAlignment="Center" /><CheckBox x:Name="CameraEnabledCheck" Grid.Row="4" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Lưu camera" Click="SaveCamera_Click" /><Button Content="Kiểm tra RTSP" Click="TestRtsp_Click" Margin="8,0,0,0" /></StackPanel>
              </Grid></Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Cảnh báo">
        <ScrollViewer><StackPanel Margin="16" Spacing="12">
          <TextBlock Text="Token và địa chỉ camera được mã hóa theo tài khoản Windows; không được đưa vào nhật ký." Foreground="#093B5A" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Background="#EAF4F9" BorderBrush="#B8D6E5" BorderThickness="1" CornerRadius="5" Padding="12"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Kiểm tra cấu hình" FontWeight="SemiBold" Foreground="#093B5A" /><TextBlock Text="Kiểm tra trường bắt buộc và trạng thái kênh; không tự gửi tin nhắn." Foreground="#52606D" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Kiểm tra toàn bộ cấu hình" Click="ValidateAlerts_Click" /><TextBlock x:Name="ConfigurationCheckText" Grid.Row="1" Grid.ColumnSpan="2" Text="Chưa kiểm tra cấu hình." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#52606D" /></Grid></Border>
          <TextBlock Text="Kênh thông báo" FontSize="16" FontWeight="SemiBold" Foreground="#093B5A" Margin="0,4,0,0" />
          <Border Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*,Auto"><CheckBox x:Name="TelegramEnabledCheck" Content="Bật Telegram" /><TextBlock Grid.Row="1" Text="Bot Token" VerticalAlignment="Center" /><TextBox x:Name="TelegramTokenText" Grid.Row="1" Grid.Column="1" PasswordChar="●" /><TextBlock Grid.Row="2" Text="Chat ID" VerticalAlignment="Center" /><TextBox x:Name="TelegramChatText" Grid.Row="2" Grid.Column="1" /><Button Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Content="Gửi thử" Click="TestTelegram_Click" Margin="10,0,0,0" /></Grid></Border>
          <Border Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*,Auto"><CheckBox x:Name="ZaloEnabledCheck" Content="Bật Zalo Bot" /><TextBlock Grid.Row="1" Text="Bot Token" VerticalAlignment="Center" /><TextBox x:Name="ZaloTokenText" Grid.Row="1" Grid.Column="1" PasswordChar="●" /><TextBlock Grid.Row="2" Text="Chat ID" VerticalAlignment="Center" /><TextBox x:Name="ZaloChatText" Grid.Row="2" Grid.Column="1" /><Button Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Content="Gửi thử" Click="TestZalo_Click" Margin="10,0,0,0" /></Grid></Border>
          <TextBlock Text="Phân tích AI" FontSize="16" FontWeight="SemiBold" Foreground="#093B5A" Margin="0,4,0,0" />
          <Border Background="#FFF8E8" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="5" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="170,*"><CheckBox x:Name="AiEnabledCheck" Content="Bật phân tích AI cho sự kiện" /><TextBlock Grid.Row="1" Text="Base URL" VerticalAlignment="Center" /><TextBox x:Name="AiBaseUrlText" Grid.Row="1" Grid.Column="1" Watermark="https://api.openai.com/v1" /><TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" /><TextBox x:Name="AiModelText" Grid.Row="2" Grid.Column="1" Watermark="Vision-capable model" /><TextBlock Grid.Row="3" Text="API key" VerticalAlignment="Center" /><TextBox x:Name="AiApiKeyText" Grid.Row="3" Grid.Column="1" PasswordChar="●" /><Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="170,100,*"><TextBlock Text="Timeout (giây)" VerticalAlignment="Center" /><TextBox x:Name="AiTimeoutText" Grid.Column="1" /><CheckBox x:Name="AiRequireConfirmationCheck" Grid.Column="2" Content="Chỉ gửi cảnh báo khi AI xác nhận chuyển động/người" Margin="14,0,0,0" VerticalAlignment="Center" /></Grid></Grid></Border>
          <TextBlock Text="Khi AI bật, tối đa hai ảnh JPEG của sự kiện (trước/sau) được gửi tới endpoint đã cấu hình; video RTSP không được gửi." TextWrapping="Wrap" Foreground="#805B12" />
          <TextBlock Text="Chẩn đoán và lưu cấu hình" FontSize="16" FontWeight="SemiBold" Foreground="#093B5A" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Mở log Zalo" Click="OpenZaloLog_Click" /><Button Content="Lưu cấu hình cảnh báo và AI" Click="SaveAlerts_Click" /></StackPanel>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Nhật ký sự kiện">
        <Grid Margin="12" RowDefinitions="Auto,*" ColumnDefinitions="*,340">
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Làm mới" Click="RefreshEvents_Click" />
            <TextBox x:Name="EventSearchText" Width="230" Watermark="Tìm camera, nguồn, trạng thái…" TextChanged="EventSearch_Changed" />
            <ComboBox x:Name="EventCameraFilter" Width="180" PlaceholderText="Tất cả camera" SelectionChanged="EventCameraFilter_Changed" />
          </StackPanel>
          <DataGrid x:Name="EventsGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All" SelectionChanged="EventsGrid_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Thời gian" Binding="{Binding DetectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="190" />
              <DataGridTextColumn Header="Camera" Binding="{Binding CameraName}" Width="130" />
              <DataGridTextColumn Header="Phát hiện" Binding="{Binding IsHumanDetection}" Width="95" />
              <DataGridTextColumn Header="Tin cậy" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="85" />
              <DataGridTextColumn Header="Nguồn" Binding="{Binding DetectionSource}" Width="150" />
              <DataGridTextColumn Header="AI" Binding="{Binding AiStatus}" Width="150" />
              <DataGridTextColumn Header="Gửi cảnh báo" Binding="{Binding DeliveryStatus}" Width="260" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D9E1E8" BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer><StackPanel Spacing="8">
              <TextBlock Text="Chi tiết sự kiện" FontSize="18" FontWeight="SemiBold" Foreground="#093B5A" />
              <TextBlock x:Name="EventDetailText" Text="Chọn một dòng để xem chi tiết." TextWrapping="Wrap" Foreground="#52606D" />
              <Border Background="#19232D" MinHeight="170"><Image x:Name="EventDetailImage" Stretch="Uniform" /></Border>
              <Button Content="Mở ảnh sự kiện" Click="OpenSelectedEventImage_Click" HorizontalAlignment="Left" />
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="4,10,4,0" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="VersionText" Text="Đang đọc phiên bản…" Foreground="#52606D" />
      <TextBlock x:Name="SystemMetricsText" Grid.Column="1" Text="CPU — · RAM —" Foreground="#52606D" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>
